{
    "name": "phenomenon-react-ts-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.10.0",
        "yarn": "please-use-pnpm",
        "npm": "please-use-pnpm"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev:vite": "vite --host",
        "dev:vite:scan": "vite --host --mode scan",
        "dev:tsc": "tsc --build --watch",
        "dev": "run-p dev:vite dev:tsc",
        "dev:scan": "run-p dev:vite:scan dev:tsc",
        "build": "vite build",
        "preview": "vite preview --host",
        "tsc": "tsc --build",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,tsx,cjs,mjs}\"",
        "lint:stylelint": "stylelint --cache -q \"**/*.css\"",
        "lint:prettier": "prettier --check \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "lint": "run-s lint:*",
        "fix:prettier": "prettier --write \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@rainbow-me/rainbowkit": "2.2.10",
        "@react-hookz/web": "^25.2.0",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@tanstack/react-form": "^1.33.0",
        "@tanstack/react-query": "^5.101.1",
        "@tanstack/react-router": "^1.170.16",
        "@tanstack/react-virtual": "^3.14.3",
        "@types/three": "^0.184.1",
        "cesium": "^1.142.0",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "fflate": "^0.8.3",
        "figma-squircle": "1.1.0",
        "ky": "^1.14.2",
        "mapbox-gl": "3.25.0",
        "maplibre-gl": "^5.24.0",
        "motion": "^12.41.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-intersection-observer": "^10.0.3",
        "react-map-gl": "^8.1.1",
        "react-number-format": "^5.4.5",
        "react-three-map": "^1.0.0",
        "three": "^0.184.0",
        "viem": "2.48.4",
        "wagmi": "2.19.5",
        "web3-avatar-react": "^1.0.5",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@eslint/js": "^9.39.2",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/plugin-svgo": "^8.1.0",
        "@tanstack/devtools-vite": "^0.8.0",
        "@tanstack/eslint-plugin-query": "^5.101.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@tanstack/react-devtools": "^0.10.7",
        "@tanstack/react-query-devtools": "^5.101.1",
        "@tanstack/react-router-devtools": "^1.167.0",
        "@tanstack/router-devtools": "^1.167.0",
        "@tanstack/router-plugin": "^1.168.18",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "autoprefixer": "^10.5.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "rollup-plugin-visualizer": "^7.0.1",
        "stylelint": "^17.13.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.0.16",
        "vite-plugin-eslint2": "^5.3.0",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-static-copy": "^4.1.1",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "4.1.10"
    }
}
